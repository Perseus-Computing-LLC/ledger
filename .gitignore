# Ledger artifacts — environment-specific, never commit
ledger.budgets.json
ledger.snapshots.jsonl
ledger.routing.jsonl
ledger.routing.log
ledger.html
ledger.err
*.ledger-bak-*
config.yaml.ledger-bak-*
# Config and its timestamped backups (config.yaml.bak-<ts>) can hold file-sourced
# secrets — never commit them (the old patterns above missed the .bak- form).
config.yaml
config.yaml.*
*.bak-*

# Python
__pycache__/
*.pyc
.venv/
venv/

