# Plutus artifacts — environment-specific, never commit
plutus.budgets.json
plutus.snapshots.jsonl
plutus.routing.jsonl
plutus.routing.log
plutus.html
plutus.err
*.plutus-bak-*
config.yaml.plutus-bak-*
# Config and its timestamped backups (config.yaml.bak-<ts>) can hold file-sourced
# secrets — never commit them (the old patterns above missed the .bak- form).
config.yaml
config.yaml.*
*.bak-*

# Python
__pycache__/
*.pyc
.venv/
venv/

# plutus_agent (monetization engine) artifacts
build/
dist/
*.egg-info/
*.db
*.db-wal
*.db-shm
quickstart.db
.playwright-mcp/
plutus-*.pdf
plutus-*.html
